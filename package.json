{
  "name": "velo-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Indoor-Cycling-Simulator: freie Fahrt, Workouts, Ausrüstung, Multiplayer",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @velo/client",
    "build": "turbo build",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "desktop": "npm run build -w @velo/client && npm run start -w @velo/desktop"
  },
  "devDependencies": {
    "turbo": "^2.11.8",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.4"
}
